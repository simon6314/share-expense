+// 接受 MM/DD 或 YYYY/MM/DD，並檢查月份與日期範圍
+function isValidDateInput(s) {
+  const m = s.match(/^(?:(\d{4})\/)?(\d{1,2})\/(\d{1,2})$/);
+  if (!m) return false;
+  const month = parseInt(m[2], 10), day = parseInt(m[3], 10);
